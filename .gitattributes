# Scripts and files read inside the Linux build container keep Unix line endings on every checkout.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.desktop   text eol=lf
*.plist     text eol=lf

# Keep pinned vendor downloads byte-identical to their SHA-256 manifest.
ui/vendor/** -text -whitespace

# Collapse third-party assets and generated evidence in the PR review by default.
ui/vendor/** linguist-vendored=true
benchmarks/baselines/*.json linguist-generated=true
